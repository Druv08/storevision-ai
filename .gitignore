# ---------------------------------------------
# Datasets / large media
# ---------------------------------------------
# Videos
*.mp4
*.avi
*.mov
*.zip

# Dataset images + label exports — keep folder structure and the plan,
# but never push raw images, test images, or labelled exports to GitHub.
dataset/**/*.jpg
dataset/**/*.jpeg
dataset/**/*.png
dataset/**/*.bmp
dataset/**/*.webp
dataset/**/*.txt
dataset/**/*.xml
dataset/**/*.json
dataset/**/*.cache
# Dataset config exported with downloaded datasets (e.g. Roboflow data.yaml)
dataset/**/*.yaml
dataset/**/*.yml
# Always keep folder markers and the tracked dataset docs
!dataset/**/.gitkeep
!dataset/DATASET_PLAN.md
!dataset/ROBOFLOW_DATASET_SOURCE.md

